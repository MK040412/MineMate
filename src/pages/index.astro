---
import Layout from '../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const authors = [
	{ name: 'Kang Minkyu', href: 'https://mk040412.github.io/' },
]

const links = [
	{ label: 'Project Weasel', href: 'https://mk040412.github.io/Project-Weasel/' },
]
---

<Layout
	title='MineMate: Multi-Agent Emergent Capability with Humans'
	pageTitle='MineMate'
	description='Sub-project of Project Weasel — studying multi-agent emergence with humans in the loop.'
	authors={authors}
	links={links}
	hero={`${base}/minemate.png`}
	heroAlt='MineMate hero image'
	faviconHref={`${base}/minemate.png`}
>
	<h1>Overview</h1>
	<ul>
		<li><b>MineMate</b> is a sub-project of <a href='https://mk040412.github.io/Project-Weasel/'>Project Weasel</a>.</li>
		<li>Coming soon.</li>
	</ul>

	<h1>Method</h1>
	<p class='muted'>Coming soon.</p>

	<h1>Results</h1>
	<p class='muted'>Coming soon.</p>

	<hr />
	<h1>Acknowledgement</h1>
	<p>
		Part of <a href='https://mk040412.github.io/Project-Weasel/'>Project Weasel</a>, maintained by{' '}
		<a href='https://mk040412.github.io/'>Kang Minkyu</a>.
	</p>
</Layout>
